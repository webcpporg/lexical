#
# lexical, validators and Boost.URL grammar rules for the string formats of
# JSON Schema. A program uses it through /webcpp/lexical//lexical, which adds
# its headers and Boost's, webcpp's configuration, webcpp::idna, for
# internationalized names, and Boost.URL's compiled part, which ipv4_address
# needs (/webcpp//boost_url, built from Boost's sources for every target).
# The regex validator is lexical's own and needs nothing else.

project /webcpp/lexical ;

# tag::dependencies[]
alias lexical
  : : : : <include>include <library>/boost//headers
    <library>/webcpp/config//config
    <library>/webcpp/idna//idna
    <library>/webcpp//boost_url ;
# end::dependencies[]
