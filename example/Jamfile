# A program that includes <webcpp/lexical/regex.hpp> holds the Unicode tables
# of ECMA-262's classes, as idna's tests of its tables do, which MSVC compiles
# only with /bigobj: the examples take it on MSVC, not measured here, where no
# Windows machine is.
project : requirements <library>/webcpp/lexical//lexical
  <toolset>msvc:<cxxflags>/bigobj ;

import webcpp ;

webcpp.targets native wasip2 wasip3 emscripten ;

# The guide's programs, each shown on the page with the output it prints.
webcpp.example lexical_quick_start.cpp ;
webcpp.example lexical_grammar.cpp ;
webcpp.example lexical_iri.cpp ;
webcpp.example lexical_regex.cpp ;
