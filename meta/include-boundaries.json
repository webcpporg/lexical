{
    "boundaries": [
        {
            "headers": [
                "include/webcpp/formats.hpp",
                "include/webcpp/formats/*.hpp",
                "include/webcpp/formats/detail/*.hpp"
            ],
            "except": [
                "include/webcpp/formats/regex.hpp",
                "include/webcpp/formats/detail/regex_*.hpp"
            ],
            "must-not-include": ["webcpp/formats/regex", "webcpp/formats/detail/regex_"],
            "why": "only regex.hpp brings the Unicode tables of ECMA-262's classes, which formats.hpp leaves out"
        },
        {
            "headers": [
                "include/webcpp/formats.hpp",
                "include/webcpp/formats/*.hpp",
                "include/webcpp/formats/detail/*.hpp"
            ],
            "must-not-include": ["webcpp/idna/detail"],
            "why": "formats uses idna's public interface"
        },
        {
            "headers": [
                "include/webcpp/formats.hpp",
                "include/webcpp/formats/*.hpp",
                "include/webcpp/formats/detail/*.hpp"
            ],
            "must-not-include": ["boost/json"],
            "why": "JSON is the tests', not the library's"
        },
        {
            "headers": [
                "include/webcpp/formats.hpp",
                "include/webcpp/formats/*.hpp",
                "include/webcpp/formats/detail/*.hpp"
            ],
            "must-not-include": ["boost/regex", "webcpp/regex", "srell"],
            "why": "is_regex is a syntax validator of formats' own: formats runs no regular expression and depends on no regex library"
        }
    ]
}
